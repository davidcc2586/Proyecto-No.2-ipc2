<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="morosidad_biblioteca" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              whenNoDataType="NoDataSection">
    <style name="ColumnHeader" mode="Opaque" backcolor="#CACED0" forecolor="#333333" fontName="DejaVu Sans" fontSize="8" isBold="true">
        <box><pen lineWidth="0.5" lineColor="#777777"/></box>
    </style>
    <style name="DetailRow" mode="Opaque" backcolor="#FFFFFF" fontName="DejaVu Sans" fontSize="8">
        <box><bottomPen lineWidth="0.4" lineColor="#BFC3C5"/></box>
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
            <style backcolor="#EEEFF0"/>
        </conditionalStyle>
    </style>
    <parameter name="fechaGeneracion" class="java.lang.String"/>
    <parameter name="totalRecargos" class="java.lang.Double"/>
    <field name="libro" class="java.lang.String"/>
    <field name="estudiante" class="java.lang.String"/>
    <field name="cui" class="java.lang.String"/>
    <field name="fechaEstimada" class="java.lang.String"/>
    <field name="diasRetraso" class="java.lang.Integer"/>
    <field name="costoDia" class="java.lang.Double"/>
    <field name="recargo" class="java.lang.Double"/>
    <title>
        <band height="114">
            <staticText>
                <reportElement x="0" y="0" width="400" height="22"/>
                <textElement><font fontName="DejaVu Sans" size="16" isBold="true"/></textElement>
                <text><![CDATA[Colegio Prestigioso]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="24" width="400" height="15"/>
                <textElement><font fontName="DejaVu Sans" size="9"/></textElement>
                <text><![CDATA[Plataforma de gestión escolar · Biblioteca]]></text>
            </staticText>
            <staticText>
                <reportElement x="677" y="2" width="45" height="16"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="727" y="2" width="75" height="16"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="8"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="47" width="802" height="1" forecolor="#777777"/></line>
            <staticText>
                <reportElement x="0" y="58" width="500" height="22"/>
                <textElement><font fontName="DejaVu Sans" size="13" isBold="true"/></textElement>
                <text><![CDATA[REPORTE DE MOROSIDAD DE BIBLIOTECA]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="88" width="802" height="16"/>
                <textElement><font fontName="DejaVu Sans" size="9"/></textElement>
                <textFieldExpression><![CDATA["Generado: " + $P{fechaGeneracion} + " · Préstamos vencidos pendientes de devolución"]]></textFieldExpression>
            </textField>
            <line><reportElement x="0" y="108" width="802" height="1" forecolor="#777777"/></line>
        </band>
    </title>
    <columnHeader>
        <band height="30">
            <staticText><reportElement style="ColumnHeader" x="0" y="0" width="150" height="30"/><textElement verticalAlignment="Middle"/><text><![CDATA[Libro]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="150" y="0" width="155" height="30"/><textElement verticalAlignment="Middle"/><text><![CDATA[Estudiante]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="305" y="0" width="100" height="30"/><textElement verticalAlignment="Middle"/><text><![CDATA[CUI]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="405" y="0" width="100" height="30"/><textElement verticalAlignment="Middle"/><text><![CDATA[Fecha límite]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="505" y="0" width="70" height="30"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Días tarde]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="575" y="0" width="100" height="30"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Costo/día]]></text></staticText>
            <staticText><reportElement style="ColumnHeader" x="675" y="0" width="127" height="30"/><textElement textAlignment="Right" verticalAlignment="Middle"/><text><![CDATA[Recargo]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="25">
            <textField isBlankWhenNull="true"><reportElement style="DetailRow" x="0" y="0" width="150" height="25"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{libro}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="DetailRow" x="150" y="0" width="155" height="25"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{estudiante}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="DetailRow" x="305" y="0" width="100" height="25"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{cui}]]></textFieldExpression></textField>
            <textField isBlankWhenNull="true"><reportElement style="DetailRow" x="405" y="0" width="100" height="25"/><textElement verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{fechaEstimada}]]></textFieldExpression></textField>
            <textField><reportElement style="DetailRow" x="505" y="0" width="70" height="25"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{diasRetraso}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="DetailRow" x="575" y="0" width="100" height="25"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{costoDia}]]></textFieldExpression></textField>
            <textField pattern="Q #,##0.00"><reportElement style="DetailRow" x="675" y="0" width="127" height="25"/><textElement textAlignment="Right" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{recargo}]]></textFieldExpression></textField>
        </band>
    </detail>
    <lastPageFooter>
        <band height="34">
            <staticText>
                <reportElement mode="Opaque" x="0" y="8" width="802" height="22" backcolor="#E6E8E9"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Sans" size="9" isBold="true"/></textElement>
                <text><![CDATA[Control operativo de préstamos · Colegio Prestigioso]]></text>
            </staticText>
        </band>
    </lastPageFooter>
    <summary>
        <band height="48">
            <line><reportElement x="0" y="5" width="802" height="1" forecolor="#777777"/></line>
            <textField>
                <reportElement x="472" y="14" width="330" height="22"/>
                <textElement textAlignment="Right"><font fontName="DejaVu Sans" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Total de recargos: " + new java.text.DecimalFormat("Q #,##0.00").format($P{totalRecargos})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    <noData>
        <band height="28">
            <staticText><reportElement x="0" y="5" width="802" height="20"/><textElement><font fontName="DejaVu Sans" size="9"/></textElement><text><![CDATA[No hay préstamos vencidos pendientes de devolución.]]></text></staticText>
        </band>
    </noData>
</jasperReport>
